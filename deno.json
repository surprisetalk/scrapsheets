{
  "unstable": [
    "raw-imports"
  ],
  "tasks": {
    "build": "mkdir -p dist && cp src/* dist && deno run -A npm:elm@0.19.2-0 make src/Main.elm --output=dist/index.js",
    "dev": "deno task build && deno run -A npm:serve dist -s -C -S -n",
    "test": "deno test --allow-all",
    "review": "deno run -A npm:elm-review@2.13.5 && deno run -A npm:elm-review@2.13.5 suppress --check-after-tests",
    "vendor": "deno run --allow-net --allow-read --allow-write vendor.ts"
  },
  "exclude": [
    "dist/",
    "data/",
    "elm-stuff/",
    "review/",
    "tui/",
    "src/automerge*",
    "src/index.html",
    "src/style.css",
    "elm.json"
  ],
  "fmt": {
    "lineWidth": 120,
    "useBraces": "preferNone",
    "singleBodyPosition": "maintain"
  },
  "test": {
    "permissions": {
      "env": true,
      "read": true,
      "write": true,
      "net": ["127.0.0.1"],
      "run": true,
      "sys": true
    }
  },
  "imports": {
    "astral": "jsr:@astral/astral@^0.5.6",
    "@hono/hono": "jsr:@hono/hono@^4.13.1",
    "@hono/hono/http-exception": "jsr:@hono/hono@^4.13.1/http-exception",
    "@hono/hono/logger": "jsr:@hono/hono@^4.13.1/logger",
    "@hono/hono/cors": "jsr:@hono/hono@^4.13.1/cors",
    "@hono/hono/jwt": "jsr:@hono/hono@^4.13.1/jwt",
    "@hono/hono/deno": "jsr:@hono/hono@^4.13.1/deno",
    "postgresjs": "https://deno.land/x/postgresjs@v3.4.9/mod.js",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server",
    "@automerge/automerge": "npm:@automerge/automerge@^3.4.0",
    "@automerge/automerge-repo": "npm:@automerge/automerge-repo@^2.5.6",
    "@automerge/automerge-repo-network-websocket": "npm:@automerge/automerge-repo-network-websocket@^2.5.6",
    "@automerge/automerge-repo-storage-nodefs": "npm:@automerge/automerge-repo-storage-nodefs@^2.5.6",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.4",
    "@electric-sql/pglite/contrib/citext": "npm:@electric-sql/pglite@^0.5.4/contrib/citext",
    "@sendgrid/mail": "npm:@sendgrid/mail@^8.1.6",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "alasql": "npm:alasql@^4.17.3",
    "prql-js": "npm:prql-js@^0.12.1",
    "elm": "npm:elm@0.19.2-0",
    "elm-format": "npm:elm-format@^0.8.8",
    "elm-review": "npm:elm-review@^2.13.5",
    "elm-test": "npm:elm-test@0.19.2-0",
    "pg-gateway": "npm:pg-gateway@^0.3.0-beta.4"
  }
}
