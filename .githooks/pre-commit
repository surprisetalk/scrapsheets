#!/bin/sh
# The test job of .github/workflows/test.yml. The schema job needs Postgres, so it runs only in CI.
set -e
for tool in gitleaks shellcheck; do command -v "$tool" >/dev/null || { echo "pre-commit: expected $tool on PATH, received none. Fix: brew install $tool" >&2; exit 1; }; done
# REVIEW: gitleaks scans each commit that main@origin lacks, @ included. Alternative: gitleaks dir. It ignores .gitignore, so it scans .env and node_modules.
ids=$(jj log --no-graph -r 'trunk()..@' -T 'commit_id ++ " "')
gitleaks git --no-banner --redact -v --log-level warn --log-opts="--no-walk ${ids% }"
jj file list 'glob:**/*.sh' | xargs shellcheck -x -P SCRIPTDIR .githooks/pre-commit
deno fmt --check
deno lint
deno check main.ts
timeout 30 deno audit
deno task review
deno task test
